# ===== IOTA / Move =====
# Network: testnet / mainnet / devnet
IOTA_NETWORK=testnet

# ⚠️ Replace with your own private key (Base64 encoded)
IOTA_PRIVATE_KEY_BASE64=YOUR_IOTA_PRIVATE_KEY_BASE64

# Replace with your deployed Move package ID
PACKAGE_ID=0xYOUR_PACKAGE_ID

# Move module and function name
MOVE_MODULE=firmware_module
MOVE_FUNCTION=publish

# ===== Database (MySQL / MariaDB) =====
DB_ENGINE=django.db.backends.mysql
DB_NAME=mydatabase
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
DB_INIT_COMMAND=SET sql_mode='STRICT_TRANS_TABLES'
DB_CHARSET=utf8mb4

# ===== Django =====
# ⚠️ Generate your own secret key for production
DJANGO_SECRET_KEY=your-django-secret-key

# Debug mode (True for development only)
DJANGO_DEBUG=True

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Timezone
DJANGO_TIME_ZONE=Asia/Taipei